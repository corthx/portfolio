{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended", ":dependencyDashboard"],

  dependencyDashboard: {
    enabled: true,
    title: "Renovate Dependency Dashboard",
    labels: ["dependencies"],
  },

  // Commit subjects (and so MR titles) follow the commit-msg hook's
  // convention: "#<issue> :<gitmoji>: [<scope>] <description>", rendered as
  // "#292 :arrow_up: [npm] Upgrade ws to 8.21.1".
  // The issue key is hardcoded to the Renovate dependency dashboard issue
  // (#292) because Renovate exposes no template field for its IID. Every
  // `#292` in this file must be updated together if the dashboard issue is
  // ever recreated with a new IID.
  commitMessagePrefix: "#292 :arrow_up: [npm]",
  commitMessageAction: "Upgrade",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{newVersion}}",

  commitBodyTable: true,

  branchPrefix: "renovate/",
  labels: ["dependencies"],
  rebaseWhen: "behind-base-branch",
  prConcurrentLimit: 10,
  // Disable hourly rate limiting; prConcurrentLimit already caps how
  // many MRs can be open at once, so the default prHourlyLimit: 2 just
  // queues legitimate updates under "Rate-Limited" on the dashboard.
  prHourlyLimit: 0,

  // The lockfile already pins the real resolution; exact ranges make each
  // MR diff show the version that actually changed.
  rangeStrategy: "pin",

  // Lets the gitlabci manager resolve the OpenTofu component's
  // `$CI_SERVER_FQDN/...` include ref.
  gitlabci: {
    registryAliases: {
      $CI_SERVER_FQDN: "gitlab.com",
    },
  },

  // Renovate ships no native manager for GitLab CI components, so track
  // them via a regex manager backed by the gitlab-tags datasource.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["(^|/)\\.gitlab/ci/.*\\.ya?ml$", "(^|/)\\.gitlab-ci\\.ya?ml$"],
      matchStrings: [
        // `$` excluded from the host class: variable hosts are skipped, not
        // captured into the unresolvable `https://$CI_SERVER_FQDN`.
        "component:\\s+(?<registryUrl>[^/\\s$]+)/(?<depName>[^@\\s]+)@(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "gitlab-tags",
      registryUrlTemplate: "https://{{registryUrl}}",
      versioningTemplate: "semver",
    },
    // Values pinned next to a `# renovate:` comment, for versions written
    // twice (the OpenTofu component's inputs mirror its include ref and the
    // mise.toml opentofu pin).
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.gitlab/ci/.+\\.gitlab-ci\\.yml$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\S+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],

  packageRules: [
    // --- Commit scopes, one per manager -------------------------------------
    {
      matchManagers: ["gitlabci", "gitlabci-include", "custom.regex"],
      commitMessagePrefix: "#292 :arrow_up: [GitLab CI]",
    },
    {
      matchManagers: ["mise"],
      commitMessagePrefix: "#292 :arrow_up: [mise]",
    },
    {
      matchManagers: ["terraform"],
      commitMessagePrefix: "#292 :arrow_up: [tofu]",
    },

    // --- npm ----------------------------------------------------------------
    // Pins stay manual: the first run's pin MR rewrites every range in
    // package.json and deserves a review.
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "npm non-major dependencies",
      commitMessageTopic: "npm non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    // Pinned in optionalDependencies to work around npm's optional dependencies
    // bug (npm/cli#4828). They must move in lockstep, so one MR bumps them all.
    // Must stay after the npm rule above: packageRules merge in order.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["@rollup/rollup-*"],
      groupName: "rollup platform binaries",
      commitMessageTopic: "rollup platform binaries",
    },
    // Nuxt sets floors on vue and vue-router (`^x.y.z`) while we pin them
    // exactly; a Nuxt bump that raises a floor alone makes npm nest a second
    // copy under node_modules/nuxt, which drops the vue-i18n `$t` augmentation
    // and fails the build type check. Automerge for patch/minor comes from the
    // npm rule above, majors stay manual via the rule at the end.
    // Must stay after the npm rule above: packageRules merge in order.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["nuxt", "vue", "vue-router"],
      groupName: "nuxt and vue",
      commitMessageTopic: "nuxt and vue",
    },
    // Security fixes are never grouped (see vulnerabilityAlerts below), so a
    // nuxt vulnerability MR can still raise a floor alone: flag it in the MR.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["nuxt"],
      prBodyNotes: [
        "⚠️ If this MR does not also bump `vue` and `vue-router`, check `node_modules/nuxt/package.json` and bump them on this branch to satisfy Nuxt's floors, or `npm ls vue vue-router` shows a nested copy and the type check fails.",
      ],
    },

    // --- CI images, mise tools, tofu ----------------------------------------
    {
      matchManagers: ["mise"],
      groupName: "mise tools",
      commitMessageTopic: "mise tools",
    },
    // A grouped branch automerges only when every dep in it is automergeable,
    // so one "pin" would otherwise hold back the whole "mise tools" group.
    {
      matchManagers: ["mise", "gitlabci", "gitlabci-include"],
      matchUpdateTypes: ["pin", "patch", "minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["gitlabci", "gitlabci-include"],
      groupName: "CI Images",
      commitMessageTopic: "CI Images",
    },
    {
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      minimumReleaseAge: "7 days",
    },
    {
      matchManagers: ["terraform"],
      matchDepTypes: ["required_provider"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      minimumReleaseAge: "7 days",
    },
    // Modules provision the tokens CI authenticates with; a bad bump locks
    // the pipeline out of the project.
    {
      matchManagers: ["terraform"],
      matchDepTypes: ["module"],
      automerge: false,
    },
    // cypress/base tags are Node versions: keep test:e2e on the Node that
    // mise installs for every other job. Must stay after the mise and CI
    // Images rules: packageRules merge in order.
    {
      matchManagers: ["mise", "gitlabci"],
      matchDepNames: ["node", "cypress/base"],
      groupName: "node",
      commitMessageTopic: "node",
      commitMessagePrefix: "#292 :arrow_up: [node]",
    },
    // npm is pinned twice: packageManager in package.json (the npm Renovate
    // writes package-lock.json with) and npm:npm in mise.toml (the npm CI runs
    // `npm ci` with). A mismatch makes Renovate's lock files fail `npm ci`, so
    // one MR bumps both. Must stay after the npm and mise rules: packageRules
    // merge in order.
    {
      matchDepNames: ["npm"],
      groupName: "npm",
      commitMessageTopic: "npm",
      commitMessagePrefix: "#292 :arrow_up: [npm]",
    },
    // OpenTofu (mise.toml, mirrored in the component's opentofu_version input)
    // and the OpenTofu CI component (include ref, mirrored in its version
    // input) move in one MR: each component release only accepts a fixed
    // list of opentofu_version values, so bumping either alone fails pipeline
    // creation. separateMajorMinor: false stops a component major from being
    // split off an OpenTofu minor, and one minimumReleaseAge keeps both halves
    // in step. Changing tofu.gitlab-ci.yml alone plans no unit, so the
    // tofu:plan label makes the MR plan them all. Must stay after the mise and
    // CI Images rules: packageRules merge in order.
    {
      matchDepNames: ["opentofu", "components/opentofu"],
      groupName: "opentofu",
      commitMessageTopic: "opentofu",
      commitMessagePrefix: "#292 :arrow_up: [tofu]",
      separateMajorMinor: false,
      minimumReleaseAge: "7 days",
      addLabels: ["tofu:plan"],
    },
    {
      matchManagers: ["mise", "custom.regex"],
      matchDepNames: ["opentofu"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },

    // Majors always manual, regardless of manager.
    {
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],

  // GitLab exposes no vulnerability alerts to Renovate; OSV is the source,
  // and its fixes get the vulnerabilityAlerts settings below.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    schedule: ["at any time"],
    labels: ["security", "dependencies"],
    commitMessagePrefix: "#292 :lock: [npm]",
    // Fixes are never grouped (Renovate forces groupName: null on them), but
    // would otherwise inherit the npm group's topic and read "Upgrade npm
    // non-major dependencies". A nuxt fix therefore never brings the matching
    // vue bump: its MR carries the prBodyNotes warning set in packageRules.
    commitMessageTopic: "{{depName}}",
  },
}
