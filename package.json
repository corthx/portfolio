{
  "name": "portfolio-corentin-hervaud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:preview": "nuxt preview",
    "dev": "NUXT_CONFIG_SSR=false nuxt dev",
    "dev:secured": "NUXT_BASE_URL=https://localhost:4173 NODE_TLS_REJECT_UNAUTHORIZED=0 NUXT_CONFIG_SSR=false nuxt dev --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "generate": "nuxt generate",
    "generate:preview": "NUXT_BASE_URL=http://localhost:3000 serve .output/public",
    "generate:preview:secured": "NUXT_BASE_URL=https://localhost:3000 NODE_TLS_REJECT_UNAUTHORIZED=0 serve .output/public --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "start-server-and-test 'serve -p 4173 .output/public' http://localhost:4173 'cypress run --e2e'",
    "test:e2e:record": "start-server-and-test 'serve -p 4173 .output/public' http://localhost:4173 'cypress run --e2e --record'",
    "test:e2e:dev": "start-server-and-test 'serve -p 4173 .output/public' http://localhost:4173 'cypress open --e2e --browser chrome'",
    "storyblok:login": "storyblok login",
    "storyblok:updatetypes": "storyblok components pull --space 314995 && storyblok ts generate --strict --space 314995 --custom-fields-parser .storyblok/custom-fields-parser.js",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "0.11.4",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/color-mode": "4.0.0",
    "@nuxtjs/i18n": "10.0.1",
    "@nuxtjs/robots": "6.0.8",
    "@nuxtjs/sitemap": "8.0.15",
    "@sentry/nuxt": "10.3.0",
    "@storyblok/nuxt": "10.1.4",
    "@tailwindcss/vite": "4.1.11",
    "@unleash/proxy-client-vue": "0.1.5",
    "@vesp/nuxt-fontawesome": "2.0.0",
    "@vueuse/nuxt": "14.0.0",
    "floating-vue": "5.2.2",
    "nuxt": "4.6.2",
    "nuxt-anchorscroll": "1.0.5",
    "nuxt-gtag": "4.0.0",
    "nuxt-seo-utils": "8.1.11",
    "nuxt-site-config": "4.0.8",
    "prettier-plugin-organize-attributes": "1.0.0",
    "primevue": "4.3.6",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.11",
    "tailwindcss-primeui": "0.6.1",
    "v-gsap-nuxt": "1.4.4",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@nuxt/eslint": "1.7.0",
    "@vue/tsconfig": "0.9.1",
    "cypress": "15.15.0",
    "eslint-plugin-cypress": "6.4.0",
    "eslint-plugin-mocha": "11.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.2.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "remove-attr": "0.0.15",
    "serve": "14.2.5",
    "start-server-and-test": "3.0.2",
    "storyblok": "4.2.2",
    "typescript": "6.0.3",
    "vite-plugin-eslint2": "5.0.4",
    "vue-tsc": "3.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-android-arm-eabi": "4.68.3",
    "@rollup/rollup-android-arm64": "4.68.3",
    "@rollup/rollup-darwin-arm64": "4.68.3",
    "@rollup/rollup-darwin-x64": "4.68.3",
    "@rollup/rollup-freebsd-arm64": "4.68.3",
    "@rollup/rollup-freebsd-x64": "4.68.3",
    "@rollup/rollup-linux-arm-gnueabihf": "4.68.3",
    "@rollup/rollup-linux-arm-musleabihf": "4.68.3",
    "@rollup/rollup-linux-arm64-gnu": "4.68.3",
    "@rollup/rollup-linux-arm64-musl": "4.68.3",
    "@rollup/rollup-linux-loongarch64-gnu": "4.50.1",
    "@rollup/rollup-linux-powerpc64le-gnu": "4.45.1",
    "@rollup/rollup-linux-riscv64-gnu": "4.68.3",
    "@rollup/rollup-linux-s390x-gnu": "4.68.3",
    "@rollup/rollup-linux-x64-gnu": "4.68.3",
    "@rollup/rollup-linux-x64-musl": "4.68.3",
    "@rollup/rollup-win32-arm64-msvc": "4.68.3",
    "@rollup/rollup-win32-ia32-msvc": "4.68.3",
    "@rollup/rollup-win32-x64-msvc": "4.68.3"
  }
